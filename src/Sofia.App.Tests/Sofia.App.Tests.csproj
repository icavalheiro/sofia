<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless UI tests: the render harness behind the screenshot gate. Each test builds the real shell, renders it
       offscreen (RenderTargetBitmap) and asserts the geometry/tokens that the specs 040-043 build on. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sofia.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sofia.App\Sofia.App.csproj" />
  </ItemGroup>

</Project>
