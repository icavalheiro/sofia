# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# OPTIONAL. Absolute Sofia.Server URL, used only when the UI is hosted somewhere
# that cannot reach the server on the same origin. Leave empty to use the same
# origin (the server serves the built UI) or the Vite dev proxy (`npm run dev`
# forwards /api and /hubs to SOFIA_SERVER_URL, default http://127.0.0.1:5199).
VITE_SOFIA_SERVER=
