<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine shared by every Sofia host (the ASP.NET server today, the Avalonia desktop and the in-process
       client later). No ASP.NET Core reference on purpose: that is what keeps the host boundary real. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sofia.Core</RootNamespace>
    <AssemblyName>Sofia.Core</AssemblyName>
    <Version>0.5.16</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <!-- Kept only to read legacy files in the one-shot LiteDB -> SQLite migration (Data/LiteDbMigration.cs); remove in 1.0. -->
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageReference Include="Microsoft.Playwright" Version="1.65.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sofia.Contracts\Sofia.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sofia.Core.Tests" />
    <InternalsVisibleTo Include="Sofia.Server.Tests" />
  </ItemGroup>

  <!-- Boot-time floor of the runtime model catalog (models.dev). Regenerate it with
       `node script/update-model-snapshot.mjs`; the build tolerates it being absent, in which case the
       catalog relies on the network and on the constants in ModelLimits. -->
  <ItemGroup>
    <EmbeddedResource Include="Providers/ModelsDevSnapshot.json"
                      LogicalName="Sofia.Core.Providers.ModelsDevSnapshot.json"
                      Condition="Exists('Providers/ModelsDevSnapshot.json')" />
  </ItemGroup>

</Project>
