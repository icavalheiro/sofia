<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Sofia.App.Controls"
             x:Class="Sofia.App.Features.Sidebar.SidebarView">

  <!-- Sidebar ported from AppSidebar.vue: brand header (40px logo + ring, 17px wordmark, gear), the two action buttons,
       the past-session quick prompt, the workspace tree and the footer slot. Geometry is the web's, resolved at the
       16px base: 288/236 column, brand padding 16/10.4, row padding 6.4/3.2, conversation rows indented 22px under a
       1px left border. The rows themselves are built in code-behind from WorkspaceRowViewModel/ConversationRowViewModel
       so a workspace with hundreds of sessions stays one measured pass. -->
  <Border x:Name="SidebarSurface"
          Background="{DynamicResource BrushSurface}"
          BorderBrush="{DynamicResource BrushBorder}"
          BorderThickness="0,0,1,0">
    <Grid x:Name="Root">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- brand -->
        <Grid x:Name="BrandRow" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="70">
          <Border Grid.Column="0"
                  x:Name="BrandLogo"
                  Width="40"
                  Height="40"
                  CornerRadius="12"
                  ClipToBounds="True"
                  BorderBrush="{DynamicResource BrushBorderStrong}"
                  BorderThickness="1"
                  VerticalAlignment="Center"
                  BoxShadow="0 0 0 3 #29A9744F">
            <Image x:Name="BrandLogoImage" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="Sofia" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold" LetterSpacing="-0.17" />
            <TextBlock x:Name="BrandTag" Text="local harness" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource BrushTextFaint}" />
          </StackPanel>
          <Button Grid.Column="2"
                  x:Name="SettingsGear"
                  Theme="{StaticResource IconButton}"
                  Width="32"
                  Height="32"
                  CornerRadius="9"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Settings">
            <controls:SofiaIcon Glyph="gear" Size="16" />
          </Button>
        </Grid>

        <!-- actions: New chat (primary) + Workspace (secondary) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="12,12,12,8" ColumnSpacing="8">
          <Button x:Name="NewChatButton" Grid.Column="0" Theme="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,7.2">
            <StackPanel Orientation="Horizontal" Spacing="6.4">
              <controls:SofiaIcon Glyph="chat" Size="15.2" Foreground="{DynamicResource BrushPrimaryInk}" />
              <TextBlock x:Name="NewChatLabel" Text="New chat" FontSize="{DynamicResource FontSizeSm}" FontWeight="Medium"
                         Foreground="{DynamicResource BrushPrimaryInk}" />
            </StackPanel>
          </Button>
          <Button x:Name="NewWorkspaceButton" Grid.Column="1" Theme="{StaticResource ActionButton}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,7.2">
            <StackPanel Orientation="Horizontal" Spacing="6.4">
              <controls:SofiaIcon Glyph="plus" Size="15.2" Foreground="{DynamicResource BrushText}" />
              <TextBlock x:Name="NewWorkspaceLabel" Text="Workspace" FontSize="{DynamicResource FontSizeSm}" FontWeight="Medium" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- past-session quick prompt -->
        <StackPanel Grid.Row="2" x:Name="SearchField" Margin="12,0,12,4">
          <Button x:Name="SearchToggle" Theme="{StaticResource ActionButton}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Padding="7,7">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <controls:SofiaIcon Grid.Column="0" Glyph="search" Size="14.4" Foreground="{DynamicResource BrushTextMuted}"
                                  VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="SearchLabel" Text="Search" FontSize="{DynamicResource FontSizeSm}"
                         Foreground="{DynamicResource BrushTextMuted}" Margin="6.4,0,0,0" VerticalAlignment="Center" />
              <Border Grid.Column="2" CornerRadius="4" Background="{DynamicResource BrushSurface}" Padding="4,1">
                <TextBlock x:Name="SearchHint" Text="Ctrl+K" Classes="mono" FontSize="{DynamicResource FontSizeXs}"
                           Foreground="{DynamicResource BrushTextFaint}" />
              </Border>
            </Grid>
          </Button>
        </StackPanel>

        <!-- add workspace form: desktop picker fills the path, the browser head types it -->
        <StackPanel Grid.Row="3" x:Name="AddForm" IsVisible="False" Margin="12,0,12,8" Spacing="4">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" x:Name="AddPathBox" Classes="input" FontSize="{DynamicResource FontSizeSm}"
                     Padding="6.4,6.4" PlaceholderText="Folder path" />
            <Button Grid.Column="1" x:Name="AddWorkspaceConfirm" Theme="{StaticResource PrimaryButton}" Padding="11,6">
              <TextBlock Text="Add" FontSize="{DynamicResource FontSizeSm}" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushPrimaryInk}" />
            </Button>
          </Grid>
          <TextBlock x:Name="AddErrorText" IsVisible="False" FontSize="{DynamicResource FontSizeXs}"
                     Foreground="{DynamicResource BrushErr}" Margin="2,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Tree" Margin="0,4,0,12" />
        </ScrollViewer>

        <StackPanel Grid.Row="5" x:Name="Footer" Margin="12,6,12,10" Spacing="6" />
      </Grid>

      <!-- overlay layer: the search pop sits under the field (z40), the workspace settings menu above it -->
      <Panel x:Name="OverlayLayer" IsHitTestVisible="False">
        <Canvas x:Name="OverlayCanvas">
          <Border x:Name="SearchPop"
                  IsVisible="False"
                  Background="{DynamicResource BrushSurface2}"
                  BorderBrush="{DynamicResource BrushBorderStrong}"
                  BorderThickness="1"
                  CornerRadius="10"
                  BoxShadow="0 12 32 0 #47000000">
            <Grid RowDefinitions="Auto,Auto">
              <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="9.6,8,9.6,8">
                <controls:SofiaIcon Grid.Column="0" Glyph="search" Size="13.6" Foreground="{DynamicResource BrushTextMuted}"
                                    VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="SearchInput" Margin="8,0,0,0" Background="Transparent"
                         BorderThickness="0" Padding="0" MinHeight="0" FontSize="{DynamicResource FontSizeSm}"
                         Foreground="{DynamicResource BrushText}" CaretBrush="{DynamicResource BrushPrimary}"
                         SelectionBrush="{DynamicResource BrushPrimarySoftStrong}"
                         PlaceholderText="Search conversations" />
                <Button Grid.Column="2" x:Name="SearchClear" Theme="{StaticResource IconButton}" Width="20" Height="20"
                        CornerRadius="6" IsVisible="False">
                  <controls:SofiaIcon Glyph="x" Size="11" />
                </Button>
              </Grid>
              <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
                <ScrollViewer x:Name="SearchScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="SearchResults" Margin="4.8" />
                </ScrollViewer>
              </Border>
            </Grid>
          </Border>
        </Canvas>
      </Panel>
    </Grid>
  </Border>
</UserControl>
