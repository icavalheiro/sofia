<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Sofia.App.Controls"
             x:Class="Sofia.App.Features.Header.HeaderView"
             ClipToBounds="False">

  <!-- ChatHeader.vue: title (16/650, max 60%), crumbs (12px, icon + name + tag/path), the LLM status dot (22px round,
       tinted per state) and the four panel toggles (30px, 8px radius). The language and session menus are in-window
       surfaces (z60) anchored under their button; they open instantly, like the web. -->
  <Panel x:Name="Root" ClipToBounds="False">
    <Border x:Name="Band"
            Padding="24,11.2,24,8.8"
            Background="{DynamicResource BrushBg}"
            BorderBrush="{DynamicResource BrushBorderSoft}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" ClipToBounds="True">
          <TextBlock x:Name="Title"
                     Classes="truncate"
                     FontSize="{DynamicResource FontSizeLg}"
                     FontWeight="SemiBold"
                     LetterSpacing="-0.16"
                     MaxWidth="720"
                     VerticalAlignment="Center" />
          <StackPanel x:Name="Crumbs" Orientation="Horizontal" Spacing="6.4" VerticalAlignment="Center">
            <controls:SofiaIcon x:Name="CrumbIcon" Glyph="folder" Size="13" Foreground="{DynamicResource BrushTextFaint}" />
            <TextBlock x:Name="CrumbName" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource BrushTextMuted}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border x:Name="CrumbTag" IsVisible="False" CornerRadius="999" Padding="6.4,0.8"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    Background="{DynamicResource BrushSurface2}" VerticalAlignment="Center">
              <TextBlock x:Name="CrumbTagText" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.6"
                         Foreground="{DynamicResource BrushTextFaint}" />
            </Border>
            <TextBlock x:Name="CrumbPath" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource BrushTextFaint}"
                       Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Border x:Name="StatusDot" IsVisible="False" Width="22" Height="22" CornerRadius="999"
                  BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}"
                  Background="{DynamicResource BrushSurface2}" VerticalAlignment="Center">
            <controls:SofiaIcon x:Name="StatusIcon" Glyph="check" Size="13.6" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" x:Name="Actions" Orientation="Horizontal" Spacing="5.6"
                    VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </Border>

    <Canvas x:Name="MenuLayer" IsHitTestVisible="False" />
  </Panel>
</UserControl>
