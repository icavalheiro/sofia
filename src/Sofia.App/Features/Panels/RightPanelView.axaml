<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Sofia.App.Controls"
             x:Class="Sofia.App.Features.Panels.RightPanelView">

  <!-- RightPanel.vue: 300px column (the shell animates its width), left border, surface fill. Head `.7rem .9rem` with the
       panel title, the refresh glyph (spins while a reload runs) and the close button; body `.8rem .9rem` with the
       changed files, the background processes and the workspace actions. Rows, badges and buttons are built in
       code-behind so the lists can be rebuilt from the backend without a binding graph. -->
  <Border Background="{DynamicResource BrushSurface}"
          BorderBrush="{DynamicResource BrushBorder}"
          BorderThickness="1,0,0,0"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14.4,11.2">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2.4">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7.2" VerticalAlignment="Center">
            <controls:SofiaIcon Glyph="panelRight" Size="16" Foreground="{DynamicResource BrushPrimary}" />
            <TextBlock x:Name="PanelTitle"
                       FontSize="{DynamicResource FontSizeSm2}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="2" x:Name="RefreshButton" Theme="{StaticResource IconButton}" Width="28" Height="28"
                  CornerRadius="8" ToolTip.Tip="Reload">
            <controls:SofiaIcon x:Name="RefreshIcon" Glyph="refresh" Size="14.4" />
          </Button>
          <Button Grid.Column="3" x:Name="CloseButton" Theme="{StaticResource IconButton}" Width="28" Height="28"
                  CornerRadius="8">
            <controls:SofiaIcon Glyph="x" Size="16" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Padding="14.4,12.8">
        <StackPanel x:Name="Body" Spacing="17.6" />
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
