<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Sofia.App.Controls"
             xmlns:sidebar="using:Sofia.App.Features.Sidebar"
             xmlns:transcript="using:Sofia.App.Features.Transcript"
             xmlns:composer="using:Sofia.App.Features.Composer"
             xmlns:header="using:Sofia.App.Features.Header"
             xmlns:panels="using:Sofia.App.Features.Panels"
             x:Class="Sofia.App.Shell.ShellView">

  <!-- Shell frame copied from App.vue: sidebar (288 normal / 236 compact) | main column (header, transcript, composer) |
       right panel (300, collapsible). The transcript/composer column is capped at 1232px and centred, the composer
       overlays the transcript on a translucent band, and every floating surface lives in OverlayHost on the web's
       z-index ladder. Layout numbers are the web's rem values resolved at the 16px base. -->
  <Grid x:Name="Root" Background="{DynamicResource BrushBg}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="288" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="0" />
    </Grid.ColumnDefinitions>

    <!-- ============================= sidebar ============================= -->
    <sidebar:SidebarView x:Name="SidebarPane" Grid.Column="0" />

    <!-- ============================== main =============================== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <header:HeaderView x:Name="HeaderPane" Grid.Row="0" />

      <Panel Grid.Row="1" ClipToBounds="True">
        <Border Background="{DynamicResource BrushBg}" />
        <Border x:Name="WallpaperLayer" IsHitTestVisible="False" />
        <Border x:Name="GrainLayer" IsHitTestVisible="False" />
        <transcript:TranscriptView x:Name="TranscriptPane" />

        <Border x:Name="ComposerBand"
                VerticalAlignment="Bottom"
                Padding="24,7.2,24,8.8"
                ClipToBounds="False"
                Classes="composer-band">
          <Grid x:Name="ComposerInner" MaxWidth="1232" ClipToBounds="False">
            <composer:ComposerView x:Name="ComposerPane" />
          </Grid>
        </Border>

        <!-- Floating task card (TaskListPanel): 280px, draggable, clamped to this panel and persisted. -->
        <panels:TaskListPanel x:Name="TaskPane" IsVisible="False" />
      </Panel>
    </Grid>

    <!-- =========================== right panel =========================== -->
    <Border x:Name="RightPanelHost"
            Grid.Column="2"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1,0,0,0"
            ClipToBounds="True">
      <panels:RightPanelView x:Name="RightPanelPane" />
    </Border>

    <!-- ======================= overlay ladder ============================ -->
    <!-- z-index ladder: 10 composer - 30-60 menus - 200 lightbox - 300 diff - 2000 settings - 2100 destructive modals. -->
    <Canvas x:Name="OverlayHost" Grid.ColumnSpan="3" IsHitTestVisible="False" />

    <!-- ============================ gate ================================= -->
    <Border x:Name="GateHost" Grid.ColumnSpan="3" IsVisible="False" Background="{DynamicResource BrushBg}" />
  </Grid>
</UserControl>
