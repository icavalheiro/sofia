<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Sofia.App.Controls"
             x:Class="Sofia.App.Shell.ShellView">

  <!-- Shell frame copied from App.vue: sidebar (288 normal / 236 compact) | main column | right panel (300, collapsible).
       The transcript/composer column is capped at 1232px and centred, the composer overlays the transcript on a
       translucent band, and every floating surface lives in OverlayHost on the web's z-index ladder. Layout numbers are
       the web's rem values resolved at the 16px base. -->
  <Grid x:Name="Root" Background="{DynamicResource BrushBg}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="288" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="0" />
    </Grid.ColumnDefinitions>

    <!-- ============================= sidebar ============================= -->
    <Border x:Name="Sidebar"
            Grid.Column="0"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,14,12,10" x:Name="BrandRow">
          <Border Grid.Column="0"
                  Width="40"
                  Height="40"
                  CornerRadius="12"
                  ClipToBounds="True"
                  BorderBrush="{DynamicResource BrushBorderStrong}"
                  BorderThickness="1">
            <Image x:Name="BrandLogo" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Sofia" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold" />
            <TextBlock x:Name="BrandSubtitle" Classes="eyebrow" Text="HARNESS" />
          </StackPanel>
          <Button Grid.Column="2" x:Name="SettingsButton" Theme="{StaticResource IconButton}" ToolTip.Tip="Settings">
            <controls:SofiaIcon Glyph="gear" Size="17" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0">
          <StackPanel x:Name="SidebarTree" Margin="8,0,8,8" Spacing="1" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" x:Name="SidebarFooter" Margin="12,6,12,10" Spacing="6" />
      </Grid>
    </Border>

    <!-- ============================== main =============================== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border x:Name="HeaderBand"
              Grid.Row="0"
              Padding="24,11.2,24,8.8"
              Background="{DynamicResource BrushBg}"
              BorderBrush="{DynamicResource BrushBorderSoft}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock x:Name="HeaderTitle" Classes="truncate" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:SofiaIcon Glyph="folder" Size="12" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" />
              <TextBlock x:Name="HeaderBreadcrumb" Classes="truncate faint" FontSize="{DynamicResource FontSizeSm}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Border x:Name="StatusPill"
                    CornerRadius="999"
                    Padding="9,3"
                    Background="{DynamicResource BrushPrimarySoft}"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <controls:SofiaIcon Glyph="loader" Size="14" Foreground="{DynamicResource BrushPrimary}" />
                <TextBlock x:Name="StatusText" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource BrushPrimary}" />
              </StackPanel>
            </Border>
            <Button x:Name="ChangesButton" Theme="{StaticResource IconButton}" ToolTip.Tip="Changes">
              <controls:SofiaIcon Glyph="panelRight" Size="17" />
            </Button>
            <Button x:Name="TasksButton" Theme="{StaticResource IconButton}" ToolTip.Tip="Tasks">
              <controls:SofiaIcon Glyph="list" Size="17" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Panel Grid.Row="1" ClipToBounds="True">
        <Border Background="{DynamicResource BrushBg}" />
        <Border x:Name="WallpaperLayer" IsHitTestVisible="False" />
        <Border x:Name="GrainLayer" IsHitTestVisible="False" />
        <ScrollViewer x:Name="TranscriptScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="TranscriptInner" MaxWidth="1232" Margin="24,20,24,150" />
        </ScrollViewer>

        <Border x:Name="ComposerBand"
                VerticalAlignment="Bottom"
                Padding="24,7.2,24,8.8"
                Classes="composer-band">
          <Grid x:Name="ComposerInner" MaxWidth="1232" RowDefinitions="Auto,Auto" />
        </Border>

        <Border x:Name="TaskPanelHost"
                IsVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="24,0,0,150"
                Classes="card"
                Padding="12"
                Width="320">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="eyebrow" Text="TASKS" />
              <TextBlock Grid.Column="1" x:Name="TaskCount" Classes="faint" FontSize="{DynamicResource FontSizeXs}" />
            </Grid>
            <StackPanel x:Name="TaskList" Spacing="6" />
          </StackPanel>
        </Border>
      </Panel>
    </Grid>

    <!-- =========================== right panel =========================== -->
    <Border x:Name="RightPanelHost"
            Grid.Column="2"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1,0,0,0"
            ClipToBounds="True">
      <Grid x:Name="RightPanelInner" RowDefinitions="Auto,*,Auto" Margin="14,12,14,12" Opacity="0">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Classes="eyebrow" Text="CHANGES" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="ClosePanelButton" Theme="{StaticResource IconButton}" ToolTip.Tip="Close">
            <controls:SofiaIcon Glyph="x" Size="16" />
          </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ChangesList" Spacing="2" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
          <TextBlock Classes="eyebrow" Text="PROCESSES" />
          <StackPanel x:Name="ProcessList" Spacing="4" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ======================= overlay ladder ============================ -->
    <!-- z-index ladder: 10 composer - 30-60 menus - 200 lightbox - 300 diff - 2000 settings - 2100 destructive modals. -->
    <Canvas x:Name="OverlayHost" Grid.ColumnSpan="3" IsHitTestVisible="False" />

    <!-- ============================ gate ================================= -->
    <Border x:Name="GateHost" Grid.ColumnSpan="3" IsVisible="False" Background="{DynamicResource BrushBg}" />
  </Grid>
</UserControl>



