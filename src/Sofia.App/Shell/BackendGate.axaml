<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Sofia.App.Controls"
             x:Class="Sofia.App.Shell.BackendGate">

  <!-- Connect screen: same copy and states as BackendGate.vue, on the Sofia canvas. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="460" Spacing="10" Margin="24,64,24,32" HorizontalAlignment="Center">
      <Border x:Name="LogoHost"
              Width="88"
              Height="88"
              CornerRadius="24"
              ClipToBounds="True"
              BorderBrush="{DynamicResource BrushBorderStrong}"
              BorderThickness="1"
              BoxShadow="0 0 0 6 #29A9744F, 0 18 40 0 #66000000"
              HorizontalAlignment="Center"
              Margin="0,0,0,8">
        <Image x:Name="Logo" Stretch="UniformToFill" />
      </Border>

      <TextBlock Text="Sofia"
                 FontSize="{DynamicResource FontSizeDisplay}"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <TextBlock x:Name="PhaseTitle" Text="Connecting to Sofia" Classes="muted" FontSize="{DynamicResource FontSizeMd2}" HorizontalAlignment="Center" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,2,0,12">
        <controls:SofiaIcon x:Name="PhaseIcon" Glyph="loader" Size="16" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" />
        <TextBlock x:Name="PhaseText" Classes="mono" VerticalAlignment="Center" Text="Looking for a local server…" />
      </StackPanel>

      <Border Classes="card" Padding="14">
        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Text="SERVER URL" />
            <TextBox x:Name="UrlBox" Classes="input" Text="http://127.0.0.1:5199" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Text="ACCESS TOKEN" />
            <TextBox x:Name="TokenBox" Classes="input" PasswordChar="•" />
          </StackPanel>
          <StackPanel x:Name="PairSection" Spacing="4">
            <TextBlock Classes="eyebrow" Text="PAIRING CODE" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="CodeBox" Classes="input" />
              <Button x:Name="PairButton" Grid.Column="1" Theme="{StaticResource ActionButton}" Margin="8,0,0,0" Content="Pair" />
            </Grid>
            <TextBlock x:Name="PairStatus" Classes="mono" FontSize="11" />
          </StackPanel>
          <Button x:Name="RetryButton" Theme="{StaticResource ActionButton}" HorizontalAlignment="Left" Content="Try again" IsVisible="False" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="4" Margin="0,6,0,0">
        <TextBlock Classes="eyebrow" Text="CONNECTION LOG" />
        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" MaxHeight="140">
          <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LogList" Spacing="2" />
          </ScrollViewer>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
