<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <OutputType Condition="'$(Configuration)' != 'Debug'">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Sofia.Desktop</RootNamespace>
    <AssemblyName>Sofia.Desktop</AssemblyName>
    <Version>0.5.0</Version>
    <ApplicationIcon>Assets\sofia.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sofia.Server\Sofia.Server.csproj" />
  </ItemGroup>

  <!-- Ship a Release build of Sofia.Server (with wwwroot) next to the desktop binary so the
       shell always launches a server that serves the web UI, even in a clean checkout. -->
  <Target Name="PublishServerForDesktop" BeforeTargets="Build" Condition="'$(RuntimeIdentifier)' == '' And !Exists('$(TargetDir)wwwroot/index.html')">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\Sofia.Server\Sofia.Server.csproj&quot; -c Release -o &quot;$(TargetDir)&quot;" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
