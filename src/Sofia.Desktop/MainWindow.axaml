<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:web="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
        x:Class="Sofia.Desktop.MainWindow"
        Title="Sofia"
        Width="1280" Height="800"
        Background="#171719"
        Icon="/Assets/sofia.ico">
    <Window.Styles>
        <!-- Coffee mug steam animation (mirrors the web CoffeeSpinner). -->
        <Style Selector="Path.steam">
            <Setter Property="StrokeLineCap" Value="Round" />
            <Style.Animations>
                <Animation Duration="0:0:2.2" IterationCount="Infinite" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="StrokeDashOffset" Value="8" />
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="Opacity" Value="0.95" />
                    </KeyFrame>
                    <KeyFrame Cue="70%">
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="StrokeDashOffset" Value="-8" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Path.steam.s2">
            <Style.Animations>
                <Animation Duration="0:0:2.2" Delay="0:0:0.45" IterationCount="Infinite" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="StrokeDashOffset" Value="8" />
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="Opacity" Value="0.95" />
                    </KeyFrame>
                    <KeyFrame Cue="70%">
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="StrokeDashOffset" Value="-8" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Path.steam.s3">
            <Style.Animations>
                <Animation Duration="0:0:2.2" Delay="0:0:0.9" IterationCount="Infinite" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="StrokeDashOffset" Value="8" />
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="Opacity" Value="0.95" />
                    </KeyFrame>
                    <KeyFrame Cue="70%">
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="StrokeDashOffset" Value="-8" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>
    <Grid>
        <web:NativeWebView x:Name="WebView" IsVisible="False" />

        <!-- Loader: matches the harness identity (grey canvas, brown accent, coffee mug). -->
        <StackPanel x:Name="Loader" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <Border Width="88" Height="88" CornerRadius="24" ClipToBounds="True"
                    BorderBrush="#43434b" BorderThickness="1" Background="#1d1d20"
                    BoxShadow="0 0 0 6 #29a9744f, 0 18 40 0 #66000000">
                <Image Source="avares://Sofia.Desktop/Assets/logo_128.png" Stretch="UniformToFill" />
            </Border>
            <TextBlock Text="Sofia" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#e9e9ec" />
            <Viewbox Width="64" Height="64">
                <Canvas Width="24" Height="24">
                    <Path Classes="steam s1" Data="M8 8 C6.5 6.5 9.5 5.5 8 4 C7.4 3.4 7.4 2.6 8 2"
                          Stroke="#a9744f" StrokeThickness="1.4" StrokeDashArray="6, 10" Opacity="0" />
                    <Path Classes="steam s2" Data="M12 8 C10.5 6.5 13.5 5.5 12 4 C11.4 3.4 11.4 2.6 12 2"
                          Stroke="#a9744f" StrokeThickness="1.4" StrokeDashArray="6, 10" Opacity="0" />
                    <Path Classes="steam s3" Data="M16 8 C14.5 6.5 17.5 5.5 16 4 C15.4 3.4 15.4 2.6 16 2"
                          Stroke="#a9744f" StrokeThickness="1.4" StrokeDashArray="6, 10" Opacity="0" />
                    <Path Data="M4 11 H18 V16 A5 5 0 0 1 13 21 H9 A5 5 0 0 1 4 16 Z"
                          Stroke="#a9744f" StrokeThickness="1.75" Fill="Transparent" StrokeLineCap="Round" />
                    <Path Data="M18 12.5 H19.5 A2.5 2.5 0 0 1 19.5 17.5 H17.6"
                          Stroke="#a9744f" StrokeThickness="1.75" Fill="Transparent" StrokeLineCap="Round" />
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="StatusText" Text="Starting server…" HorizontalAlignment="Center" Foreground="#a0a0a8" />
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="False">
            <TextBlock x:Name="ErrorText" Text="" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Center" Foreground="#c9705f" />
            <Button x:Name="RetryButton" Content="Retry" HorizontalAlignment="Center" Click="OnRetryClick"
                    Background="#a9744f" Foreground="#171719" />
        </StackPanel>
    </Grid>
</Window>
